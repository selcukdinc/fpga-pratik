@@ -21,6 +21,20 @@
 #include "rt/mspace.h"
 #include "thread.h"
 
+#if defined __EMSCRIPTEN__ && !defined __EMSCRIPTEN_PTHREADS__
+#include <semaphore.h>
+#include <errno.h>
+// Single threaded wasm build: nothing can post while we wait
+int sem_timedwait(sem_t *sem, const struct timespec *abstime)
+{
+   (void)abstime;
+   if (sem_trywait(sem) == 0)
+      return 0;
+   errno = ETIMEDOUT;
+   return -1;
+}
+#endif
+
 #include <assert.h>
 #include <errno.h>
 #include <math.h>
@@ -1294,7 +1308,11 @@ static void suspend_handler(int sig, siginfo_t *info, void *context)
    unmask_fatal_signals(&mask);
    sigdelset(&mask, SIGRESUME);
 
+#ifdef __EMSCRIPTEN__
+   (void)mask;  // no signals between wasm threads
+#else
    sigsuspend(&mask);
+#endif
 
    sem_post(&stop_sem);
 
